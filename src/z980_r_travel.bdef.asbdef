managed implementation in class zbp_980_r_travel unique;
strict ( 2 );

define behavior for Z980_R_TRAVEL alias Travel
persistent table z980_travel
lock master
authorization master ( instance )
etag master LastChangedAt
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) AgencyId, TravelId;

  action cancel_travel;

  mapping for z980_travel corresponding
    {
      AgencyID           = agency_ID;
      TravelID           = travel_id;
      CustomerID         = customer_id;
      BeginDate          = begin_date;
      EndDate            = end_date;
      CreatedAt          = created_at;
      CreatedBy          = created_by;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }
}